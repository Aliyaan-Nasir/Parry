{
  "name": "parry",
  "version": "0.1.0",
  "private": true,
  "description": "Parry keeps leveraged positions on NEAR, Hyperliquid and EVM chains from being liquidated, and runs a delta-neutral NEAR vault. A TEE guardian acts only within an on-chain mandate, after a verifiable AI review.",
  "author": "Aliyaan Nasir",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "postinstall": "test -n \"$PARRY_SKIP_PACKAGE_BUILD\" || pnpm -F @parry/core -F @parry/sdk -F @parry/mcp build",
    "build:contracts": "contracts/scripts/build.sh",
    "test:contracts": "cd contracts && cargo test --workspace --exclude parry-sandbox-tests",
    "test:sandbox": "cd contracts && cargo test -p parry-sandbox-tests",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint && eslint scripts",
    "build": "pnpm -r --if-present build",
    "deploy:testnet": "bun scripts/deploy.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "verify": "bun scripts/verify.ts",
    "dev": "bun scripts/dev.ts",
    "sandbox": "bun scripts/sandbox.ts",
    "security": "bun scripts/security.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@parry/core": "workspace:*",
    "@types/bun": "1.3.1",
    "near-kit": "0.20.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "postgres": "3.4.9",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-848j-6mx2-7j84"
      ]
    }
  }
}
