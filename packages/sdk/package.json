{
  "name": "@parryguard/sdk",
  "version": "0.1.0",
  "description": "Read and act on Parry: positions, risk, vault, mandates and guardian decisions.",
  "author": "Aliyaan Nasir",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "parry-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliyaan-Nasir/Parry.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Aliyaan-Nasir/Parry/tree/main/packages/sdk",
  "keywords": [
    "parry",
    "near",
    "liquidation",
    "risk",
    "defi",
    "vault",
    "passkey",
    "x402",
    "tee"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=parry-source",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@parryguard/core": "workspace:*",
    "near-kit": "0.20.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
