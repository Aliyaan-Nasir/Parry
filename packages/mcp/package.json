{
  "name": "@parry/mcp",
  "version": "0.1.0",
  "description": "MCP server for Parry: risk, vault, guardian log and policy-limited testnet actions.",
  "author": "Aliyaan Nasir",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "parry-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "parry-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliyaan-Nasir/Parry.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Aliyaan-Nasir/Parry/tree/main/packages/mcp",
  "keywords": [
    "parry",
    "mcp",
    "model-context-protocol",
    "near",
    "liquidation",
    "risk",
    "agents",
    "defi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=parry-source",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@parry/sdk": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@parry/core": "workspace:*",
    "@types/bun": "1.3.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
