# TLS for the API on the VM. The site itself is on Vercel; DNS points API_DOMAIN here.
{
	servers {
		# The API sits behind Cloudflare's proxy: trust its edges (https://www.cloudflare.com/ips)
		# to name the visitor in CF-Connecting-IP. Any other peer is the client itself.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000 {
		# Per-address limits key on the right-most entry: make it the visitor, not the edge.
		header_up X-Forwarded-For {client_ip}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
