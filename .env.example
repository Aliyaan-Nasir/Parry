# Parry: copy to .env. Every value has a working public testnet default or is optional.
# Service wallet keys never go here: the deploy script writes them to the gitignored .env.services.

# One switch for every service, script and the app: testnet or mainnet.
PARRY_NETWORK=testnet

# Postgres (compose provides it; for services run outside compose, point at your own).
DATABASE_URL=postgres://parry:parry@localhost:55432/parry
POSTGRES_PASSWORD=parry

# NEAR RPC endpoints, tried in order.
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://testnet-rpc.intea.rs,https://near-testnet.drpc.org

# Where the site reaches the API (compose maps the API to port 4000).
PUBLIC_API_URL=http://localhost:4000

# The guardian enclave on OutLayer (filled from deployments/testnet.json when empty).
# ENCLAVE_MODE=local runs the enclave program natively for sandbox work only.
ENCLAVE_MODE=outlayer
ENCLAVE_WASM_URL=
ENCLAVE_WASM_SHA256=
ENCLAVE_SECRETS_PROFILE=parry

# NEAR AI Cloud key: stored as an OutLayer secret for the enclave; needed here only to publish it.
NEARAI_API_KEY=

# Optional: a 1Click partner key for confidential dry-run quotes (public quotes work without it).
ONECLICK_JWT=

# Optional alert channels.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
RESEND_API_KEY=
DIGEST_FROM=

# The EVM rescue's chain RPC (Base Sepolia on testnet, Base on mainnet).
EVM_RPC_URL=https://sepolia.base.org

# Top-up targets, name:account:targetNear (scripts/deploy.ts writes the line into .env.services).
TOPUP_WALLETS=
TREASURY_MIN_NEAR=20

# On the VM only: the API's public domain for Caddy's TLS.
API_DOMAIN=

# NEAR's Agent Market listing (scripts/market.ts --register writes these; the market service answers hires).
MARKET_URL=https://market.near.ai
MARKET_AGENT_ID=
MARKET_AGENT_TOKEN=
