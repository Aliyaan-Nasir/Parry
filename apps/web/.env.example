# Which NEAR network the app talks to: testnet or mainnet. The Market shock page exists only on testnet.
NEXT_PUBLIC_PARRY_NETWORK=testnet
# Base URL of the Parry API (no trailing slash). The browser reads /v1/stats and more from it; it is also allowed in the CSP.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of the source repository, shown as the GitHub link in the footer. Leave empty to hide the link.
NEXT_PUBLIC_REPO_URL=
# Public URL of this site, used for absolute Open Graph image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
